# =============================================================================
# .gitignore - Projeto MNIST Digit Classifier
# =============================================================================
# Este arquivo especifica quais arquivos o Git deve IGNORAR.
#
# ✅ VERSIONADO:
#    • Código fonte (.py, .ipynb)
#    • README.md, requirements.txt, LICENSE
#    • Imagens próprias (data/own_images/)
#    • Resultados principais (results/*.png, results/*.csv)
#    • Imagens do README (docs/images/)
#
# ❌ IGNORADO:
#    • Ambientes virtuais, cache Python
#    • Checkpoints do Jupyter
#    • Configurações de IDE
#    • Dataset em cache (data/mnist.npz)
#    • Modelos treinados (.pkl, .joblib)
#    • Credenciais (.env, chaves)
# =============================================================================


# =============================================================================
# 1. PYTHON - ARQUIVOS COMPILADOS E CACHE
# =============================================================================

__pycache__/
*.py[cod]
*$py.class
*.so

# Distribuição e empacotamento
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Logs de instalação
pip-log.txt
pip-delete-this-directory.txt


# =============================================================================
# 2. AMBIENTES VIRTUAIS
# =============================================================================

venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
virtualenv/


# =============================================================================
# 3. JUPYTER NOTEBOOK
# =============================================================================

.ipynb_checkpoints/
*.ipynb_checkpoints

# Configurações do JupyterLab
.jupyter/
jupyter_config.json


# =============================================================================
# 4. IDE / EDITOR
# =============================================================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Spyder
.spyderproject
.spyproject

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace


# =============================================================================
# 5. SISTEMA OPERACIONAL
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*


# =============================================================================
# 6. DADOS - IGNORAR DATASETS GRANDES, MANTER IMAGENS PRÓPRIAS
# =============================================================================

# Ignorar dados brutos e processados
data/raw/
data/processed/

# Ignorar arquivos de dados grandes
data/*.pkl
data/*.pickle
data/*.h5
data/*.hdf5
data/*.npy
data/*.parquet
data/*.feather

# ⚠️ EXCEÇÃO: MANTER as imagens próprias do Desafio C
!data/own_images/
!data/own_images/*.jpg
!data/own_images/*.jpeg
!data/own_images/*.png

# ⚠️ EXCEÇÃO: MANTER dados de exemplo pequenos
!data/samples/
!data/samples/*


# =============================================================================
# 7. RESULTADOS - VERSIONAR IMAGENS E TABELAS PRINCIPAIS
# =============================================================================

# Ignorar arquivos temporários e de cache
results/*.tmp
results/*.cache
results/*.log
results/temp/
results/.ipynb_checkpoints/

# Ignorar arquivos grandes específicos (descomente se necessário)
# results/comparison_table_full.csv
# results/*_backup.png

# ⚠️ EXCEÇÃO: MANTER imagens PNG
!results/*.png

# ⚠️ EXCEÇÃO: MANTER tabelas CSV
!results/*.csv

# ⚠️ EXCEÇÃO: MANTER painéis consolidados
!results/own_predictions/
!results/own_predictions/*.png

# ⚠️ EXCEÇÃO: MANTER gráficos de análise
!results/ood_*.png
!results/loss_analysis.png
!results/validation_iterative.png
!results/cross_validation.png

# Ignorar arquivos de debug
results/debug_*.py
results/debug_*.txt


# =============================================================================
# 8. DOCUMENTAÇÃO - MANTER IMAGENS DO README
# =============================================================================

# Ignorar builds de documentação
docs/_build/
docs/build/
site/

# ⚠️ EXCEÇÃO: MANTER imagens usadas no README
!docs/images/
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.jpeg
!docs/images/*.gif


# =============================================================================
# 9. MODELOS TREINADOS
# =============================================================================

# Ignorar modelos salvos (são binários grandes)
models/
saved_models/
checkpoints/

# Arquivos de modelo
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.pb
*.onnx
*.tflite

# ⚠️ EXCEÇÃO: MANTER modelos pequenos de exemplo (se houver)
# !models/example_model.pkl


# =============================================================================
# 10. CREDENCIAIS E SEGURANÇA
# =============================================================================

# Arquivos de ambiente
.env
.env.local
.env.*.local
*.env

# Chaves e certificados
*.pem
*.key
*.crt
*.p12
*.pfx

# Configurações locais com credenciais
config.local.*
secrets.*
credentials.*


# =============================================================================
# 11. CACHE E TEMPORÁRIOS
# =============================================================================

# Cache Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.cover
.cache

# Cache geral
cache/
.cache/
tmp/
temp/
*.tmp
*.temp


# =============================================================================
# 12. ARQUIVOS ESPECÍFICOS DO PROJETO
# =============================================================================

# Arquivos temporários de imagens processadas
temp_processed_*.png
processed_*.jpg
*_temp.ipynb
*_test.ipynb
untitled*.ipynb

# Arquivos de debug
debug_*.py
debug_*.txt
debug_*.log

# Notebooks backup
*_backup.ipynb
*_old.ipynb
*-Copy*.ipynb
*-Copy*.py


# =============================================================================
# 13. DOCKER (SE APLICÁVEL)
# =============================================================================

.dockerignore
Dockerfile.local
docker-compose.override.yml


# =============================================================================
# 14. GITHUB ACTIONS (NÃO IGNORAR)
# =============================================================================

# ⚠️ NÃO ignorar workflows do GitHub Actions
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/workflows/*.yaml


# =============================================================================
# RESUMO DO QUE É VERSIONADO
# =============================================================================
#
# ✅ VERSIONADO:
#    • README.md, requirements.txt, LICENSE
#    • mnist_pipeline.ipynb (notebook)
#    • mnist_pipeline.py (se existir)
#    • check_requirements.py (se existir)
#    • data/own_images/*.jpg (imagens próprias)
#    • results/*.png (gráficos gerados)
#    • results/*.csv (tabelas de resultados)
#    • results/own_predictions/*.png (painéis)
#    • docs/images/*.png (imagens do README)
#
# ❌ IGNORADO:
#    • data/mnist.npz (cache do MNIST)
#    • venv/, __pycache__/, .ipynb_checkpoints/
#    • .vscode/, .idea/, .DS_Store, Thumbs.db
#    • models/ (modelos treinados)
#    • .env, chaves e credenciais
#    • Arquivos temporários e caches
#
# =============================================================================
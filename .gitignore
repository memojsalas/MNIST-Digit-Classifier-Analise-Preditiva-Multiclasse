# =============================================================================
# .gitignore - Projeto MNIST Digit Classifier
# Pipeline de Classificação com Random Forest, KNN e MLP (scikit-learn)
# =============================================================================


# =============================================================================
# 1. PYTHON - ARQUIVOS COMPILADOS E CACHE
# =============================================================================

# Bytecode compilado do Python (gerado automaticamente)
__pycache__/
*.py[cod]
*$py.class

# Arquivos C-extension compilados
*.so

# Distribuição e empacotamento
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Logs de instalação
pip-log.txt
pip-delete-this-directory.txt


# =============================================================================
# 2. AMBIENTES VIRTUAIS
# =============================================================================

venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
virtualenv/



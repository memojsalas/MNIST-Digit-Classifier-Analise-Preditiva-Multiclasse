# =============================================================================
# 6. DADOS - DATASETS E ARQUIVOS GRANDES
# =============================================================================

# Datasets brutos e processados (MNIST é baixado automaticamente)
data/raw/
data/processed/

# Arquivos de dados grandes
*.csv
*.tsv
*.h5
*.hdf5
*.npz
*.npy
*.parquet
*.feather

# ⚠️ EXCEÇÃO: Manter as imagens próprias do Desafio C
!data/own_images/
!data/own_images/*.jpg
!data/own_images/*.jpeg
!data/own_images/*.png

# ⚠️ EXCEÇÃO: Manter dados de exemplo pequenos
!data/samples/
!data/samples/*


# =============================================================================
# 7. RESULTADOS E OUTPUTS
# =============================================================================

# Resultados gerados durante execução
results/
output/
outputs/

# Gráficos e figuras gerados automaticamente
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.pdf
*.eps

# ⚠️ EXCEÇÃO: Manter imagens usadas no README
!docs/images/
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.jpeg

# Logs
*.log
logs/
*.log.*

# Métricas exportadas
metrics/


